{
  "expo": {
    "name": "VaultKey",
    "slug": "VaultKey",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vaultkey",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": ""
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060B17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siddhantpal.VaultKey"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060B17"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.siddhantpal.VaultKey",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "file", "mimeType": "*/*", "pathPattern": ".*\\.pnb" },
            { "scheme": "content", "mimeType": "*/*", "pathPattern": ".*\\.pnb" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-share-intent"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
