{
  "expo": {
    "name": "VaultKey",
    "slug": "VaultKey",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vaultkey",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7e9c0982-bc75-4bb5-9df6-e880e0e1c793"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060B17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siddhantpal.VaultKey",
      "infoPlist": {
        "NSCameraUsageDescription": "VaultKey needs access to your camera to scan QR codes for 2FA."
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060B17"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.siddhantpal.VaultKey",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.pnb"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.pnb"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-share-intent",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "VaultKey needs access to your camera to scan QR codes for 2FA."
        }
      ],
      "./withAppLabel.js"
    ],
    "extra": {
      "eas": {
        "projectId": "7e9c0982-bc75-4bb5-9df6-e880e0e1c793"
      }
    },
    "owner": "siddhantpals"
  }
}
